{
  "rules": {
    ".read": false,
    ".write": false,
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "exhibitions": {
      ".read": true,
      "$exhibitionId": {
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
        ".validate": "newData.child('createdAt').isNumber() && newData.hasChildren(['title', 'description', 'works', 'startsAt']) && (newData.child('status').val() === 'active' || newData.child('status').val() === 'closed')"
      }
    },
    "drafts": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$exhibitionId": {
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
        ".validate": "newData.child('status').val() === 'draft' && newData.child('createdAt').isNumber()"
      }
    },
    "voteCounts": {
      ".read": true,
      "$exhibitionId": {
        "$workId": {
          ".write": "(auth != null && root.child('admins').child(auth.uid).val() === true) || (root.child('exhibitions').child($exhibitionId).child('status').val() === 'active' && root.child('exhibitions').child($exhibitionId).child('works').child($workId).exists() && data.exists() && newData.isNumber() && newData.val() === data.val() + 1)",
          ".validate": "newData.isNumber() && newData.val() >= 0"
        }
      }
    }
  }
}
